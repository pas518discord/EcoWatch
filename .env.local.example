# ─────────────────────────────────────────────────────────
# ECOWATCH — Environment Variables
# ─────────────────────────────────────────────────────────

# ── AWS DynamoDB ──────────────────────────────────────────
# These 3 are auto-added by Vercel when you connect AWS
# via the Storage tab — copy from Vercel project settings
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ── NASA FIRMS (Fire Data) ────────────────────────────────
# Free key — takes 1 min to get:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_firms_key_here

# ── OpenAQ (Air Quality) ──────────────────────────────────
# Optional — works without it at lower rate limits
# Get free key at: https://explore.openaq.org/
OPENAQ_API_KEY=

# ── Anthropic Claude (AI Insights) ───────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Cron Job Security ─────────────────────────────────────
# Any random string — protects /api/ingest from public access
# Generate one: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── NextAuth v5 ───────────────────────────────────────────
# Generate secret: openssl rand -hex 32
# When NEXTAUTH_SECRET is unset, the app runs in open "demo mode"
# (middleware does not enforce login).
NEXTAUTH_SECRET=your_nextauth_secret_here
# Local dev:
NEXTAUTH_URL=http://localhost:3000
